front/next-env.d.ts
*.tsbuildinfo
# Playwright's saved storageState holds a live session cookie. The leading **/
# matters: a pattern with an inner slash is anchored to this file's directory,
# so a bare `e2e/.auth/` would only match /e2e, never front/e2e.
**/e2e/.auth/
**/test-results/
**/playwright-report/
