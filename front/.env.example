# Where the Next server reaches the Nest API — Server Components read through
# it, and `next.config.js` rewrites the browser's /api calls to it.
#
# The browser never sees this host. It only ever calls /api on its own origin,
# which is why the CSP can stay at `connect-src 'self'` in every environment and
# why no NEXT_PUBLIC_* variable is needed here. NEXT_PUBLIC_* would be inlined
# into the bundle at `next build` time anyway, so it could never be corrected by
# ecosystem.config.cjs afterwards.
SPIRA_API_URL=http://127.0.0.1:6700
