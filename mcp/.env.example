# Issued in Spira under Settings → API tokens. Shown once at creation; if it is lost, revoke it and
# make another. It is a bearer credential — anything holding it can read and write every issue.
SPIRA_API_TOKEN=

# Only needed to point at something other than production, e.g. http://localhost:6700/api in dev.
# SPIRA_API_URL=https://spira.1991computer.com/api
